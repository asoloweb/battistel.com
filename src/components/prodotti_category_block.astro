---
import Breadcrumbs from './Breadcrumbs.astro';
import { directusAssetUrl, directusFetch, directusItemsUrl } from '../lib/directus';
import { buildBrandLogoMap, buildProductSlugMap, getProductTitle, resolveAssetId, resolveProductThumbnailSrc } from '../lib/products';
import { slugifyLabel } from '../lib/slug';

const CATEGORY_CARD_IMAGE = directusAssetUrl('491185c0-ede3-4ffd-b149-5872266922fa', {
	width: 760,
	quality: 72,
	format: 'webp',
});
const PRODUCT_CARD_IMAGE = directusAssetUrl('929fe30e-dd29-4d56-99fe-d34325d9d70b', {
	width: 760,
	quality: 72,
	format: 'webp',
});

interface Category {
	id?: number | string;
	status?: string;
	sort?: number;
	titolo_categoria?: string;
	descrizione_categoria?: string;
	immagine_categoria?: unknown;
	immagine?: string;
	image?: string;
	parent_categoria?: unknown;
	parent?: unknown;
	parent_id?: unknown;
	categoria_padre?: unknown;
	categoria_padre_id?: unknown;
	[key: string]: unknown;
}

interface CategoryRelation {
	Categorie_id?: Category | number | null;
}

interface Product {
	id?: number;
	status?: string;
	sort?: number;
	codice_prodotto?: string;
	titolo?: string;
	foto_prodotto?: string;
	marchio?: { id?: number | string; nome_marchio?: string } | number | null;
	Categoria?: CategoryRelation[];
	Tag?: { Tags_id?: { titolo_tag?: string; nascosto?: boolean | number | string | null } | number | null }[];
	[key: string]: unknown;
}

interface Brand {
	id?: number | string;
	logo_marchio?: unknown;
	logo?: unknown;
	immagine?: unknown;
	image?: unknown;
}

interface Props {
	titolo?: string;
	filterCategorySlug: string;
	selectedCategoryLabel: string;
}

const { titolo = 'Prodotti', filterCategorySlug, selectedCategoryLabel } = Astro.props as Props;
const searchQueryRaw = (Astro.url.searchParams.get('q') || '').trim();
const normalizeForSearch = (value: unknown) =>
	String(value || '')
		.toLowerCase()
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.replace(/[^a-z0-9\s-]/g, ' ')
		.replace(/\s+/g, ' ')
		.trim();
const searchQuery = normalizeForSearch(searchQueryRaw);
const normalizedFilterCategorySlug = normalizeFilterToken(filterCategorySlug);

function resolveImageSrc(value: string | undefined) {
	return directusAssetUrl(value, {
		width: 760,
		quality: 72,
		format: 'webp',
	});
}

function normalizeFilterToken(value: string) {
	return (value || '').trim().toLowerCase();
}

async function fetchBrands(): Promise<Brand[]> {
	try {
		const url = directusItemsUrl('Marchi');
		url.searchParams.set('fields', 'id,logo_marchio');
		url.searchParams.set('limit', '-1');
		const response = await directusFetch(url);
		if (!response.ok) return [];
		const payload = await response.json();
		return Array.isArray(payload?.data) ? (payload.data as Brand[]) : [];
	} catch (error) {
		console.error('Errore caricando i marchi:', error);
		return [];
	}
}

function resolveToken(value: unknown): string {
	if (typeof value === 'number') return String(value);
	if (typeof value === 'string') return value.trim();
	if (typeof value === 'object' && value) {
		const nestedId = (value as { id?: unknown }).id;
		if (typeof nestedId === 'number') return String(nestedId);
		if (typeof nestedId === 'string') return nestedId.trim();
	}
	return '';
}

function getParentCategoryToken(category: Category): string | null {
	const candidates = [
		category.parent_categoria,
		category.parent,
		category.parent_id,
		category.categoria_padre,
		category.categoria_padre_id,
		category.parent_category,
		category.parentCategory,
		category.padre,
	] as unknown[];

	for (const candidate of candidates) {
		const token = resolveToken(candidate);
		if (token) return token;
	}

	return null;
}

async function fetchCategories(): Promise<Category[]> {
	try {
		const url = directusItemsUrl('Categorie');
		url.searchParams.set('fields', '*');
		url.searchParams.set('filter[status][_eq]', 'published');
		url.searchParams.set('sort', 'sort,titolo_categoria');
		const response = await directusFetch(url);
		if (!response.ok) return [];
		const payload = await response.json();
		return Array.isArray(payload?.data) ? (payload.data as Category[]) : [];
	} catch (error) {
		console.error('Errore caricando le categorie prodotti:', error);
		return [];
	}
}

async function fetchProducts(): Promise<Product[]> {
	try {
		const url = directusItemsUrl('Prodotti');
		url.searchParams.set(
			'fields',
			'*,marchio.id,marchio.nome_marchio,Categoria.Categorie_id.id,Categoria.Categorie_id.titolo_categoria,Categoria.Categorie_id.status,Tag.Tags_id.titolo_tag,Tag.Tags_id.nascosto,descrizione_breve,descrizione_estesa'
		);
		url.searchParams.set('filter[status][_eq]', 'published');
		url.searchParams.set('limit', '-1');
		url.searchParams.set('sort', 'sort,codice_prodotto');
		const response = await directusFetch(url);
		if (!response.ok) return [];
		const payload = await response.json();
		return Array.isArray(payload?.data) ? (payload.data as Product[]) : [];
	} catch (error) {
		console.error('Errore caricando i prodotti:', error);
		return [];
	}
}

function extractProductTags(product: Product) {
	if (!Array.isArray(product?.Tag)) return [];
	const tags = product.Tag
		.map((entry) => {
			const related = entry?.Tags_id && typeof entry.Tags_id === 'object' ? entry.Tags_id : null;
			const isHidden = related?.nascosto === true || related?.nascosto === 1 || related?.nascosto === '1';
			if (isHidden) return null;
			const label = related?.titolo_tag?.trim() || '';
			if (!label) return null;
			return { slug: normalizeFilterToken(label), label };
		})
		.filter((entry): entry is { slug: string; label: string } => Boolean(entry));

	return Array.from(new Map(tags.map((entry) => [entry.slug, entry.label])), ([slug, label]) => ({ slug, label }));
}

function extractSearchTagLabels(product: Product) {
	if (!Array.isArray(product?.Tag)) return [];
	const labels = product.Tag
		.map((entry) => {
			const related = entry?.Tags_id && typeof entry.Tags_id === 'object' ? entry.Tags_id : null;
			const label = related?.titolo_tag?.trim() || '';
			return label || null;
		})
		.filter((entry): entry is string => Boolean(entry));

	return Array.from(new Set(labels));
}

function getProductCategories(product: Product) {
	if (!Array.isArray(product?.Categoria)) return [];

	return product.Categoria
		.map((entry) => {
			const category = entry?.Categorie_id && typeof entry.Categorie_id === 'object' ? entry.Categorie_id : null;
			if (!category) return null;
			const token = resolveToken(category.id);
			const label = category.titolo_categoria?.trim() || '';
			if (!token || !label) return null;
			return {
				token,
				label,
				slug: slugifyLabel(label) || token,
			};
		})
		.filter((entry): entry is { token: string; label: string; slug: string } => Boolean(entry));
}

const categories = await fetchCategories();
const products = await fetchProducts();
const brands = await fetchBrands();
const brandLogoById = buildBrandLogoMap(brands);
const productSlugMap = buildProductSlugMap(products);

const categoryTreeMap = new Map<string, { token: string; slug: string; parentToken: string | null; title: string; description: string; imageSrc: string }>();
for (const category of categories) {
	const token = resolveToken(category?.id);
	const label = category.titolo_categoria?.trim() || '';
	if (!token || !label) continue;
	const imageField =
		resolveAssetId(category.immagine_categoria) ||
		resolveAssetId(category.immagine) ||
		resolveAssetId(category.image);
	categoryTreeMap.set(token, {
		token,
		slug: slugifyLabel(label) || token,
		parentToken: getParentCategoryToken(category),
		title: label,
		description: category.descrizione_categoria?.trim() || '',
		imageSrc: resolveImageSrc(imageField),
	});
}

const parentByCategory = new Map<string, string>();
for (const node of categoryTreeMap.values()) {
	if (node.parentToken) parentByCategory.set(node.token, node.parentToken);
}

const selectedCategoryNode =
	Array.from(categoryTreeMap.values()).find((node) => normalizeFilterToken(node.slug) === normalizedFilterCategorySlug) || null;
const breadcrumbCategoryItems = [] as { name: string; href?: string }[];

if (selectedCategoryNode) {
	const chain = [] as { title: string; slug: string }[];
	let currentToken: string | null = selectedCategoryNode.token;
	const visited = new Set<string>();

	while (currentToken && !visited.has(currentToken)) {
		visited.add(currentToken);
		const node = categoryTreeMap.get(currentToken);
		if (!node) break;
		chain.unshift({ title: node.title, slug: node.slug });
		currentToken = node.parentToken;
	}

	breadcrumbCategoryItems.push(
		...chain.map((entry, index) => ({
			name: entry.title,
			href: index < chain.length - 1 ? `/prodotti/categoria/${encodeURIComponent(entry.slug)}` : undefined,
		}))
	);
}

const subcategoryCards = selectedCategoryNode
	? Array.from(categoryTreeMap.values())
			.filter((node) => node.parentToken === selectedCategoryNode.token)
			.map((node) => ({
				title: node.title,
				description: node.description,
				href: `/prodotti/categoria/${encodeURIComponent(node.slug)}`,
				imageSrc: node.imageSrc || CATEGORY_CARD_IMAGE,
				slug: node.slug,
			}))
	: [];

const hasSubcategories = subcategoryCards.length > 0;
const hasSearchQuery = searchQuery.length > 0;

// Raccoglie i token di tutte le sottocategorie (ricorsivamente) della categoria corrente
function collectDescendantSlugs(token: string, treeMap: typeof categoryTreeMap): Set<string> {
	const result = new Set<string>();
	for (const node of treeMap.values()) {
		if (node.parentToken === token) {
			result.add(node.slug);
			for (const descendantSlug of collectDescendantSlugs(node.token, treeMap)) {
				result.add(descendantSlug);
			}
		}
	}
	return result;
}

// Calcola tutti gli slug validi per la categoria corrente (se stessa + tutte le discendenti)
const validCategorySlugs: Set<string> = selectedCategoryNode
	? new Set([normalizedFilterCategorySlug, ...collectDescendantSlugs(selectedCategoryNode.token, categoryTreeMap)])
	: normalizedFilterCategorySlug
	? new Set([normalizedFilterCategorySlug])
	: new Set();

const productsData = products
	.map((product) => {
		if (typeof product.id !== 'number') return null;
		const slug = productSlugMap.get(product.id) || '';
		if (!slug) return null;
		const directCategories = getProductCategories(product);
		const categorySlugs = new Set<string>();
		const categorySearchTokens = new Set<string>();
		const categoryPathLabels: string[] = [];

		for (const category of directCategories) {
			let currentToken: string | undefined = category.token;
			const chainLabels = [category.label];
			categorySlugs.add(category.slug);
			categorySearchTokens.add(category.label);
			categorySearchTokens.add(category.slug.replace(/-/g, ' '));
			while (currentToken) {
				const parentToken = parentByCategory.get(currentToken);
				if (!parentToken) break;
				const parentNode = categoryTreeMap.get(parentToken);
				if (!parentNode) break;
				categorySlugs.add(parentNode.slug);
				categorySearchTokens.add(parentNode.title);
				categorySearchTokens.add(parentNode.slug.replace(/-/g, ' '));
				chainLabels.unshift(parentNode.title);
				currentToken = parentToken;
			}
			categoryPathLabels.push(chainLabels.join(' / '));
		}

		const tags = extractProductTags(product);
		const searchTagLabels = extractSearchTagLabels(product);
		const brandName = product.marchio && typeof product.marchio === 'object' ? product.marchio.nome_marchio?.trim() || '' : '';

		return {
			title: getProductTitle(product) || 'Prodotto',
			href: `/prodotti/${slug}`,
			imageSrc: resolveProductThumbnailSrc(product, {
				defaultImage: PRODUCT_CARD_IMAGE,
				brandLogoById,
				width: 760,
				quality: 72,
				format: 'webp',
			}),
			categorySlugs: Array.from(categorySlugs),
			categoryPathLabel: Array.from(new Set(categoryPathLabels)).join(', '),
			tags,
			searchText: normalizeForSearch([
				getProductTitle(product) || 'Prodotto',
				brandName,
				String(product.codice_prodotto || '').trim(),
				String(product.descrizione_breve || '').trim(),
				String(product.descrizione_estesa || '').trim(),
				String(product.descrizione || '').trim(),
				...Array.from(categorySearchTokens),
				...searchTagLabels,
			].join(' ')),
		};
	})
	.filter((entry): entry is { title: string; href: string; imageSrc: string; categorySlugs: string[]; categoryPathLabel: string; tags: { slug: string; label: string }[]; searchText: string } => Boolean(entry))
	// Filtra per categoria corrente + tutte le sue discendenti
	.filter((entry) => entry.categorySlugs.some((s) => validCategorySlugs.has(s)));

const subcategorySearchMap = new Map<string, string>();
for (const card of subcategoryCards) {
	const productsForCard = productsData.filter((entry) => entry.categorySlugs.includes(card.slug));
	const searchText = normalizeForSearch([
		card.title,
		card.description,
		...productsForCard.map((entry) => entry.searchText),
	].join(' '));
	subcategorySearchMap.set(card.slug, searchText);
}

const sidebarTagMap = new Map<string, string>();
for (const product of productsData) {
	for (const tag of product.tags) {
		if (!sidebarTagMap.has(tag.slug)) sidebarTagMap.set(tag.slug, tag.label);
	}
}

const sidebarTagEntriesJson = JSON.stringify(Array.from(sidebarTagMap.entries()));
const searchedSubcategoryCards = hasSearchQuery
	? subcategoryCards.filter((entry) => (subcategorySearchMap.get(entry.slug) || entry.title.toLowerCase()).includes(searchQuery))
	: subcategoryCards;
const searchedProductsData = hasSearchQuery
	? productsData.filter((entry) => entry.searchText.includes(searchQuery))
	: productsData;
const displayedSubcategoryCards = hasSearchQuery ? searchedSubcategoryCards : subcategoryCards;
const displayedProductsData = hasSearchQuery ? searchedProductsData : hasSubcategories ? [] : productsData;
const displayedCategoryCountLabel = `${displayedSubcategoryCards.length} ${displayedSubcategoryCards.length === 1 ? 'categoria' : 'categorie'}`;
const displayedProductCountLabel = `${displayedProductsData.length} ${displayedProductsData.length === 1 ? 'prodotto' : 'prodotti'}`;
const searchProductsTitle = `Prodotti trovati nella categoria ${selectedCategoryLabel || selectedCategoryNode?.title || 'selezionata'}`;
---

	<section class="products_block" data-aos="fade-up" data-aos-duration="1500">
		<div class="products_block_inner">
			<Breadcrumbs
				items={[
					{ name: 'Prodotti', href: '/prodotti' },
					...(breadcrumbCategoryItems.length > 0 ? breadcrumbCategoryItems : [{ name: selectedCategoryLabel }]),
				]}
				showGlobalSearch={true}
				showQuoteButton={true}
				searchAction={Astro.url.pathname}
				searchPlaceholder={`Cerca in ${selectedCategoryLabel || 'categoria'}`}
				searchValue={searchQueryRaw}
			/>

		{!hasSubcategories && productsData.length > 0 && (
			<div class="products_selected_filters">
				<div class="products_category_tags" data-category-tag-wrap>
					<div class="products_tag_pills" data-category-tag-pills-selected></div>
					<button class="products_tag_pills_toggle" type="button" data-tag-pills-toggle aria-expanded="false" aria-label="Espandi filtri tag">+</button>
				</div>
			</div>
		)}

		{hasSubcategories ? (
			<>
				{hasSearchQuery && (
					<div class="products_results_head">
						<p class="products_results_count" data-results-count>
							{displayedProductCountLabel}, {displayedCategoryCountLabel}
						</p>
					</div>
				)}
				{hasSearchQuery && displayedProductsData.length > 0 && (
					<div class="products_result_section" data-subcategories-products-section>
						<h3 class="products_result_section_title">{searchProductsTitle}</h3>
						<div class="products_grid">
							{displayedProductsData.map((entry) => (
								<a class="products_card" href={entry.href} data-tags={entry.tags.map((tag) => tag.slug).join(',')} data-search={entry.searchText}>
									{entry.imageSrc && (
										<div class="products_card_media">
											<img src={entry.imageSrc} alt={entry.title} loading="lazy" />
										</div>
									)}
									<h3 class="products_card_title">{entry.title}</h3>
									{entry.categoryPathLabel && <p class="products_card_category_path">{entry.categoryPathLabel}</p>}
								</a>
							))}
						</div>
					</div>
				)}
				{displayedSubcategoryCards.length > 0 && (
					<div class="products_result_section" data-subcategories-categories-section>
						<h3 class="products_result_section_title">Categorie</h3>
						<div class="products_subcategories_grid">
						{displayedSubcategoryCards.map((entry) => (
							<a class="products_subcategory_card" href={entry.href}>
								{entry.imageSrc && (
									<div class="products_subcategory_media">
										<img src={entry.imageSrc} alt={entry.title} loading="lazy" />
									</div>
								)}
								<h3 class="products_subcategory_title">{entry.title}</h3>
								{entry.description && <p class="products_subcategory_description">{entry.description}</p>}
							</a>
						))}
						</div>
					</div>
				)}
				{displayedSubcategoryCards.length === 0 && displayedProductsData.length === 0 && (
					<p class="products_empty_static products_empty_subcategories">
						Nessuna categoria o prodotto trovato con la ricerca inserita.
					</p>
				)}
			</>
		) : displayedProductsData.length > 0 ? (
			<>
				<div class="products_results_head">
					<p class="products_results_count" data-results-count>{displayedProductsData.length} prodotti</p>
					<button class="products_clear_filters" type="button" data-clear-filters>Reset filtri</button>
				</div>

				<div class="products_grid">
					{displayedProductsData.map((entry) => (
						<a class="products_card" href={entry.href} data-tags={entry.tags.map((tag) => tag.slug).join(',')} data-search={entry.searchText}>
							{entry.imageSrc && (
								<div class="products_card_media">
									<img src={entry.imageSrc} alt={entry.title} loading="lazy" />
								</div>
							)}
							<h3 class="products_card_title">{entry.title}</h3>
							{hasSearchQuery && entry.categoryPathLabel && <p class="products_card_category_path">{entry.categoryPathLabel}</p>}
						</a>
					))}
				</div>

				<p class="products_empty">Nessun prodotto disponibile con i filtri selezionati.</p>
			</>
		) : (
			<p class="products_empty_static">
				Nessun prodotto disponibile in questa categoria.
			</p>
		)}
	</div>
</section>

{!hasSubcategories && productsData.length > 0 && <script is:inline define:vars={{ sidebarTagEntriesJson: JSON.parse(sidebarTagEntriesJson) }}>
	(() => {
		const tagLabelMap = new Map(sidebarTagEntriesJson);
		const searchQuery = (new URLSearchParams(window.location.search).get('q') || '').trim().toLowerCase();
		const splitValues = (value) =>
			(value || '')
				.split(',')
				.map((item) => item.trim())
				.filter(Boolean);

		const cards = Array.from(document.querySelectorAll('.products_card'));
		const emptyElement = document.querySelector('.products_empty');
		const countElement = document.querySelector('[data-results-count]');
		const clearButton = document.querySelector('[data-clear-filters]');
		const selectedCategoryPillsContainer = document.querySelector('[data-category-tag-pills-selected]');
		const selectedCategoryTagWrap = document.querySelector('[data-category-tag-wrap]');
		const tagPillsToggleButton = document.querySelector('[data-tag-pills-toggle]');
		const selectedTags = new Set();

		const updateTagPillsToggle = () => {
			if (!(selectedCategoryTagWrap instanceof HTMLElement) || !(tagPillsToggleButton instanceof HTMLButtonElement)) return;
			if (selectedCategoryTagWrap.hidden) {
				tagPillsToggleButton.hidden = true;
				selectedCategoryTagWrap.classList.remove('is-expanded');
				tagPillsToggleButton.setAttribute('aria-expanded', 'false');
				tagPillsToggleButton.textContent = '+';
				return;
			}

			tagPillsToggleButton.hidden = false;
			const expanded = selectedCategoryTagWrap.classList.contains('is-expanded');
			tagPillsToggleButton.setAttribute('aria-expanded', expanded ? 'true' : 'false');
			tagPillsToggleButton.textContent = expanded ? '-' : '+';
		};
		const cardMatchesSelectedTags = (card, excludeTag = '') => {
			const tags = splitValues(card.getAttribute('data-tags'));
			if (selectedTags.size === 0) return true;
			return Array.from(selectedTags).every((tag) => {
				if (excludeTag && tag === excludeTag) return true;
				return tags.includes(tag);
			});
		};

		const cardMatchesSearch = (card) => {
			if (!searchQuery) return true;
			const searchable = (card.getAttribute('data-search') || '').toLowerCase();
			return searchable.includes(searchQuery);
		};

		const cardMatchesFilters = (card, excludeTag = '') => cardMatchesSearch(card) && cardMatchesSelectedTags(card, excludeTag);

		const createTagPillButton = (tag, label, count) => {
			const isAll = tag === '';
			const isActive = isAll ? selectedTags.size === 0 : selectedTags.has(tag);
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'products_tag_pill';
			if (isActive) button.classList.add('is-active');
			button.setAttribute('data-tag-pill', tag);
			button.setAttribute('aria-pressed', isActive ? 'true' : 'false');

			const labelSpan = document.createElement('span');
			labelSpan.className = 'products_tag_pill_label';
			labelSpan.textContent = `${label} (${count})`;
			button.appendChild(labelSpan);

			if (isActive && !isAll) {
				const removeSpan = document.createElement('span');
				removeSpan.className = 'products_tag_pill_remove';
				removeSpan.setAttribute('aria-hidden', 'true');
				removeSpan.textContent = '×';
				button.appendChild(removeSpan);
			}

			button.addEventListener('click', () => {
				if (isAll) {
					selectedTags.clear();
				} else if (selectedTags.has(tag)) {
					selectedTags.delete(tag);
				} else {
					selectedTags.add(tag);
				}
				applyFilters();
			});
			return button;
		};

		const renderTagPills = () => {
			if (!(selectedCategoryPillsContainer instanceof HTMLElement) || !(selectedCategoryTagWrap instanceof HTMLElement)) return;
			selectedCategoryPillsContainer.innerHTML = '';

			const availableTags = new Set();
			const tagCounts = new Map();
			cards.filter((card) => cardMatchesFilters(card)).forEach((card) => {
				splitValues(card.getAttribute('data-tags')).forEach((tag) => availableTags.add(tag));
			});

			Array.from(availableTags).forEach((tag) => {
				const count = cards.filter((card) => {
					if (!cardMatchesFilters(card, tag)) return false;
					const tags = splitValues(card.getAttribute('data-tags'));
					return tags.includes(tag);
				}).length;
				tagCounts.set(tag, count);
			});

			selectedTags.forEach((tag) => availableTags.add(tag));

			if (availableTags.size === 0) {
				selectedCategoryTagWrap.hidden = true;
				updateTagPillsToggle();
				return;
			}

			selectedCategoryTagWrap.hidden = false;
			const totalCount = cards.filter((card) => cardMatchesFilters(card)).length;
			selectedCategoryPillsContainer.appendChild(createTagPillButton('', 'Tutti i prodotti', totalCount));
			Array.from(availableTags)
				.sort((a, b) => (tagLabelMap.get(a) || a).localeCompare(tagLabelMap.get(b) || b, 'it', { sensitivity: 'base' }))
				.forEach((tag) => {
					selectedCategoryPillsContainer.appendChild(createTagPillButton(tag, tagLabelMap.get(tag) || tag, tagCounts.get(tag) || 0));
				});

			updateTagPillsToggle();
		};

		const updateClearButton = () => {
			const hasFilters = selectedTags.size > 0;
			if (clearButton instanceof HTMLElement) clearButton.style.visibility = hasFilters ? 'visible' : 'hidden';
		};

		const applyFilters = () => {
			renderTagPills();
			let visibleCount = 0;
			cards.forEach((card) => {
				const match = cardMatchesFilters(card);
				card.style.display = match ? '' : 'none';
				if (match) visibleCount += 1;
			});

			if (emptyElement instanceof HTMLElement) emptyElement.style.display = visibleCount > 0 ? 'none' : 'block';
			if (countElement instanceof HTMLElement) countElement.textContent = `${visibleCount} prodotti`;
			updateClearButton();
		};

		if (clearButton instanceof HTMLElement) {
			clearButton.addEventListener('click', () => {
				selectedTags.clear();
				if (selectedCategoryTagWrap instanceof HTMLElement) selectedCategoryTagWrap.classList.remove('is-expanded');
				applyFilters();
			});
		}

		if (tagPillsToggleButton instanceof HTMLButtonElement && selectedCategoryTagWrap instanceof HTMLElement) {
			tagPillsToggleButton.addEventListener('click', () => {
				selectedCategoryTagWrap.classList.toggle('is-expanded');
				updateTagPillsToggle();
			});
		}

		applyFilters();
	})();
</script>}

