---
import { directusAssetUrl } from '../lib/directus';

interface PageRef {
	id?: number;
	slug?: string;
}

interface SingleCard {
	id?: number;
	titolo_card?: string;
	sottotitolo_card?: string;
	immagine?: string;
	href?: string;
	link?: PageRef | number | null;
	link_label?: string;
	link_esterno?: string;
}

interface CardRelation {
	single_card_id?: SingleCard | number | null;
}

interface Props {
	titolo?: string;
	card?: CardRelation[] | SingleCard[];
	scorrimento_orizzontale?: boolean;
}

const { titolo = '', card = [], scorrimento_orizzontale = false } = Astro.props;

function resolveImageSrc(value: string | undefined) {
	return directusAssetUrl(value, {
		width: 760,
		quality: 72,
		format: 'webp',
	});
}

function normalizeCards(input: CardRelation[] | SingleCard[]) {
	if (!Array.isArray(input)) return [];
	return input
		.map((entry) => {
			if (!entry || typeof entry !== 'object') return null;
			if ('single_card_id' in entry) {
				return entry.single_card_id && typeof entry.single_card_id === 'object'
					? (entry.single_card_id as SingleCard)
					: null;
			}
		if (
			'titolo_card' in entry ||
			'sottotitolo_card' in entry ||
			'immagine' in entry ||
			'href' in entry ||
			'link_label' in entry ||
			'link_esterno' in entry
		) {
				return entry as SingleCard;
			}
			return null;
		})
		.filter((entry): entry is SingleCard => Boolean(entry));
}

function getCardHref(card: SingleCard) {
	if (card.link_esterno?.trim()) return card.link_esterno.trim();
	if (card.href) return card.href;
	if (card.link && typeof card.link === 'object' && card.link.slug) {
		return card.link.slug === 'home' ? '/' : `/${card.link.slug}`;
	}
	return '';
}

const cards = normalizeCards(card);
---

{cards.length > 0 && (
	<section class="cards_block" data-aos="fade-up" data-aos-duration="1500">
		<div class="cards_block_inner">
			{titolo && <h2 class="cards_block_title">{titolo}</h2>}

			{scorrimento_orizzontale ? (
				<div class="cards_slider swiper" data-cards-slider>
					<div class="swiper-wrapper">
						{cards.map((single) => {
							const href = getCardHref(single);
							const hasLabelLink = Boolean(single.link_label?.trim());
							const Tag = href ? 'a' : 'div';
							const imageSrc = resolveImageSrc(single.immagine);
							const isExternal = Boolean(single.link_esterno?.trim());

							return (
								<Tag class="cards_card swiper-slide" href={href || undefined} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>
									{imageSrc && (
										<div class="cards_card_media">
											<img src={imageSrc} alt={single.titolo_card || ''} loading="lazy" />
										</div>
									)}
									{single.titolo_card && <h3 class="cards_card_title">{single.titolo_card}</h3>}
									{single.sottotitolo_card && (
										<p class="cards_card_subtitle">{single.sottotitolo_card}</p>
									)}
									{hasLabelLink && <span class="cards_card_link">{single.link_label}</span>}
								</Tag>
							);
						})}
					</div>
					{cards.length > 1 && <div class="swiper-pagination"></div>}
					{cards.length > 1 && <div class="swiper-button-prev"></div>}
					{cards.length > 1 && <div class="swiper-button-next"></div>}
				</div>
			) : (
				<div class="cards_grid">
					{cards.map((single) => {
						const href = getCardHref(single);
						const hasLabelLink = Boolean(single.link_label?.trim());
						const Tag = href ? 'a' : 'div';
						const imageSrc = resolveImageSrc(single.immagine);
						const isExternal = Boolean(single.link_esterno?.trim());

						return (
							<Tag class="cards_card" href={href || undefined} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>
								{imageSrc && (
									<div class="cards_card_media">
										<img src={imageSrc} alt={single.titolo_card || ''} loading="lazy" />
									</div>
								)}
								{single.titolo_card && <h3 class="cards_card_title">{single.titolo_card}</h3>}
								{single.sottotitolo_card && (
									<p class="cards_card_subtitle">{single.sottotitolo_card}</p>
								)}
								{hasLabelLink && <span class="cards_card_link">{single.link_label}</span>}
							</Tag>
						);
					})}
				</div>
			)}
		</div>
	</section>
)}

<script is:inline>
	(() => {
		const init = () => {
			const sliders = document.querySelectorAll('[data-cards-slider]');
			sliders.forEach((slider) => {
				if (!(slider instanceof HTMLElement) || slider.dataset.swiperInitialized === 'true' || !window.Swiper) return;

				const slides = slider.querySelectorAll('.swiper-slide');
				new window.Swiper(slider, {
					loop: slides.length > 1,
					speed: 500,
					slidesPerView: 3,
					spaceBetween: 24,
					pagination: {
						el: slider.querySelector('.swiper-pagination'),
						clickable: true,
					},
					navigation: {
						prevEl: slider.querySelector('.swiper-button-prev'),
						nextEl: slider.querySelector('.swiper-button-next'),
					},
					breakpoints: {
						0: { slidesPerView: 1, spaceBetween: 16 },
						640: { slidesPerView: 2, spaceBetween: 18 },
						1024: { slidesPerView: 3, spaceBetween: 24 },
					},
				});

				slider.dataset.swiperInitialized = 'true';
			});
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', init, { once: true });
		} else {
			init();
		}
	})();
</script>

<style>
	.cards_block {
		padding: 40px 20px 20px;
	}

	.cards_block_inner {
		max-width: var(--max-width);
		margin: 0 auto;
	}

	.cards_block_title {
		margin: 0 0 24px;
		color: var(--nero);
		font-size: clamp(28px, 4vw, 42px);
		border-bottom: 4px solid var(--arancione-battistel);
		padding-bottom: 20px;
	}

	.cards_grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}

	.cards_card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 55px 40px;
		background: var(--bianco);
		border-radius: 18px;
		color: var(--nero);
		transition: transform 200ms ease, box-shadow 200ms ease;
		min-height: 100%;
		transition: all .4s ease-out;
	}

	.cards_card:hover {
		scale:1.03;
	} 

	a.cards_card:hover {
		transform: translateY(-4px);
		box-shadow: 0 16px 30px rgba(0, 0, 0, 0.15);
	}

	.cards_card_media {
		overflow: hidden;
		border-radius: 12px;
		aspect-ratio: 4 / 3;
		background: #fff;
	}

	.cards_card_media img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.cards_card_title {
		margin: 4px 0 0;
		font-size: 33px;
		line-height: 33px;
		text-align: center;
	}

	.cards_card_subtitle {
		margin: 0;
		font-size: 16px;
		line-height: 1.45;
		color: rgba(0, 0, 0, 0.75);
	}

	.cards_card_link {
		margin-top: auto;
		align-self: flex-start;
		font-weight: 600;
		text-underline-offset: 2px;
		width: 100%;
		text-align: center;
		color: var(--arancione-battistel);
		text-decoration: none;
	}

	@media (max-width: 1024px) {
		.cards_grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.cards_grid {
			grid-template-columns: 1fr;
		}
	}

	.cards_slider {
		padding: 0 50px 50px;
		overflow: hidden;
	}

	.cards_slider :global(.swiper-wrapper) {
		align-items: stretch;
	}

	.cards_slider .cards_card {
		height: auto;
	}

	.cards_slider :global(.swiper-pagination) {
		bottom: 0;
	}

	.cards_slider :global(.swiper-pagination-bullet) {
		background: var(--arancione-battistel);
		opacity: 0.35;
	}

	.cards_slider :global(.swiper-pagination-bullet-active) {
		opacity: 1;
	}

	.cards_slider :global(.swiper-button-prev),
	.cards_slider :global(.swiper-button-next) {
		color: var(--arancione-battistel);
		top: 50%;
		transform: translateY(-50%);
	}

	@media (max-width: 640px) {
		.cards_slider {
			padding: 0 44px 44px;
		}
	}
</style>
