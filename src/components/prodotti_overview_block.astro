---
import Breadcrumbs from './Breadcrumbs.astro';
import { directusAssetUrl, directusFetch, directusItemsUrl } from '../lib/directus';
import { buildBrandLogoMap, buildProductSlugMap, getProductTitle, resolveAssetId, resolveProductThumbnailSrc } from '../lib/products';
import { slugifyLabel } from '../lib/slug';

const CATEGORY_CARD_IMAGE = 'https://admin.battistel.com/assets/491185c0-ede3-4ffd-b149-5872266922fa';
const PRODUCT_CARD_IMAGE = 'https://admin.battistel.com/assets/929fe30e-dd29-4d56-99fe-d34325d9d70b';
const initialSearchQuery = (Astro.url.searchParams.get('q') || '').trim();

interface Category {
	id?: number | string;
	status?: string;
	sort?: number;
	titolo_categoria?: string;
	descrizione_categoria?: string;
	immagine_categoria?: unknown;
	immagine?: string;
	image?: string;
	parent?: unknown;
	parent_categoria?: unknown;
	parent_id?: unknown;
	categoria_padre?: unknown;
	categoria_padre_id?: unknown;
	[key: string]: unknown;
}

interface CategoryRelation {
	Categorie_id?: Category | number | null;
}

interface Product {
	id?: number;
	status?: string;
	sort?: number;
	titolo?: string;
	foto_prodotto?: string;
	imballo?: string;
	marchio?: { id?: number | string; nome_marchio?: string } | number | null;
	Categoria?: CategoryRelation[];
	Tag?: { Tags_id?: { titolo_tag?: string; nascosto?: boolean | number | string | null } | number | null }[];
	[key: string]: unknown;
}

interface Brand {
	id?: number | string;
	logo_marchio?: unknown;
	logo?: unknown;
	immagine?: unknown;
	image?: unknown;
}

function resolveImageSrc(value: string | undefined, width = 760) {
	return directusAssetUrl(value, {
		width,
		quality: 72,
		format: 'webp',
	});
}

function extractParentId(raw: unknown): string {
	if (raw === null || raw === undefined || raw === '') return '';
	if (typeof raw === 'number' || typeof raw === 'string') return String(raw).trim();
	if (typeof raw === 'object' && raw) {
		const id = (raw as { id?: number | string | null }).id;
		if (id === null || id === undefined) return '';
		return String(id).trim();
	}
	return '';
}

async function fetchBrands(): Promise<Brand[]> {
	try {
		const url = directusItemsUrl('Marchi');
		url.searchParams.set('fields', 'id,logo_marchio');
		url.searchParams.set('limit', '-1');
		const response = await directusFetch(url);
		if (!response.ok) return [];
		const payload = await response.json();
		return Array.isArray(payload?.data) ? (payload.data as Brand[]) : [];
	} catch (error) {
		console.error('Errore caricando i marchi:', error);
		return [];
	}
}

function getParentKey(category: Category): string {
	const candidates = [
		category.parent_categoria,
		category.parent,
		category.parent_id,
		category.categoria_padre,
		category.categoria_padre_id,
		category.parent_category,
		category.parentCategory,
		category.padre,
	] as unknown[];

	for (const value of candidates) {
		const resolved = extractParentId(value);
		if (resolved) return resolved;
	}

	return '';
}

async function fetchCategories(): Promise<Category[]> {
	try {
		const url = directusItemsUrl('Categorie');
		url.searchParams.set('fields', '*');
		url.searchParams.set('filter[status][_eq]', 'published');
		url.searchParams.set('sort', 'sort,titolo_categoria');
		const response = await directusFetch(url);
		if (!response.ok) return [];
		const payload = await response.json();
		return Array.isArray(payload?.data) ? (payload.data as Category[]) : [];
	} catch (error) {
		console.error('Errore caricando le categorie prodotti:', error);
		return [];
	}
}

async function fetchProducts(): Promise<Product[]> {
	try {
		const url = directusItemsUrl('Prodotti');
		url.searchParams.set(
			'fields',
			'*,marchio.id,marchio.nome_marchio,Categoria.Categorie_id.id,Categoria.Categorie_id.titolo_categoria,Tag.Tags_id.titolo_tag,Tag.Tags_id.nascosto'
		);
		url.searchParams.set('filter[status][_eq]', 'published');
		url.searchParams.set('limit', '-1');
		url.searchParams.set('sort', 'sort,codice_prodotto');
		const response = await directusFetch(url);
		if (!response.ok) return [];
		const payload = await response.json();
		return Array.isArray(payload?.data) ? (payload.data as Product[]) : [];
	} catch (error) {
		console.error('Errore caricando i prodotti:', error);
		return [];
	}
}

function extractProductTags(product: Product) {
	if (!Array.isArray(product?.Tag)) return [];
	const tags = product.Tag
		.map((entry) => {
			const related = entry?.Tags_id && typeof entry.Tags_id === 'object' ? entry.Tags_id : null;
			const isHidden = related?.nascosto === true || related?.nascosto === 1 || related?.nascosto === '1';
			if (isHidden) return null;
			const label = related?.titolo_tag?.trim() || '';
			if (!label) return null;
			return { slug: slugifyLabel(label) || label.toLowerCase(), label };
		})
		.filter((entry): entry is { slug: string; label: string } => Boolean(entry));

	return Array.from(new Map(tags.map((entry) => [entry.slug, entry.label])), ([slug, label]) => ({ slug, label }));
}

function extractSearchableTagLabels(product: Product) {
	if (!Array.isArray(product?.Tag)) return [];
	const labels = product.Tag
		.map((entry) => {
			const related = entry?.Tags_id && typeof entry.Tags_id === 'object' ? entry.Tags_id : null;
			return related?.titolo_tag?.trim() || '';
		})
		.filter(Boolean);

	return Array.from(new Set(labels));
}

function splitCommaValues(value: string | undefined) {
	if (!value) return [];
	return value
		.split(',')
		.map((entry) => entry.trim())
		.filter(Boolean);
}

const categories = await fetchCategories();
const products = await fetchProducts();
const brands = await fetchBrands();
const brandLogoById = buildBrandLogoMap(brands);
const productSlugMap = buildProductSlugMap(products);

const categoryLabelById = new Map<string, string>();
const categoryParentById = new Map<string, string>();
const categoryChildrenByParent = new Map<string, string[]>();

for (const category of categories) {
	const categoryId = String(category.id || '').trim();
	if (!categoryId) continue;
	const label = String(category.titolo_categoria || '').trim();
	if (!label) continue;
	categoryLabelById.set(categoryId, label);
	const parentId = getParentKey(category);
	if (parentId) {
		categoryParentById.set(categoryId, parentId);
		const list = categoryChildrenByParent.get(parentId) || [];
		list.push(categoryId);
		categoryChildrenByParent.set(parentId, list);
	}
}

function collectDescendantLabels(rootId: string): string[] {
	const labels: string[] = [];
	const stack = [...(categoryChildrenByParent.get(rootId) || [])];
	const visited = new Set<string>();
	while (stack.length > 0) {
		const current = stack.pop() || '';
		if (!current || visited.has(current)) continue;
		visited.add(current);
		const label = categoryLabelById.get(current);
		if (label) labels.push(label);
		const children = categoryChildrenByParent.get(current) || [];
		for (const child of children) stack.push(child);
	}
	return labels;
}

const topLevelCategories = categories.filter((category) => !getParentKey(category));

function collectAncestorLabels(categoryId: string): string[] {
	const labels: string[] = [];
	const visited = new Set<string>();
	let current = categoryParentById.get(categoryId) || '';
	while (current && !visited.has(current)) {
		visited.add(current);
		const label = categoryLabelById.get(current);
		if (label) labels.push(label);
		current = categoryParentById.get(current) || '';
	}
	return labels;
}

function buildCategoryCards(source: Category[]) {
	const usedSlugs = new Set<string>();
	return source
	.filter((category) => category?.id !== null && category?.id !== undefined)
	.map((category) => {
		const baseSlug = slugifyLabel(category.titolo_categoria) || String(category.id || '').trim();
		if (!baseSlug) return null;
		const categoryId = String(category.id || '').trim();
		const descendantLabels = categoryId ? collectDescendantLabels(categoryId) : [];
		const ancestorLabels = categoryId ? collectAncestorLabels(categoryId) : [];
		let slug = baseSlug;
		if (usedSlugs.has(slug)) slug = `${baseSlug}-${String(category.id)}`;
		usedSlugs.add(slug);
		const imageField =
			resolveAssetId(category.immagine_categoria) ||
			resolveAssetId(category.immagine) ||
			resolveAssetId(category.image);

		return {
			title: category.titolo_categoria || 'Categoria',
			description: category.descrizione_categoria || '',
			href: `/prodotti/categoria/${encodeURIComponent(slug)}`,
			imageSrc: resolveImageSrc(imageField) || CATEGORY_CARD_IMAGE,
			searchText: [category.titolo_categoria || '', category.descrizione_categoria || '', ...ancestorLabels, ...descendantLabels].join(' ').toLowerCase(),
		};
	})
	.filter(
		(entry): entry is { title: string; description: string; href: string; imageSrc: string; searchText: string } => Boolean(entry)
	);
}

const categoryCardsTopLevel = buildCategoryCards(topLevelCategories);
const categoryCardsSearch = buildCategoryCards(categories);

const productsData = products
	.map((product) => {
		if (typeof product.id !== 'number') return null;
		const slug = productSlugMap.get(product.id) || '';
		if (!slug) return null;
		const title = getProductTitle(product) || 'Prodotto';
		const tags = extractProductTags(product);
		const searchableTags = extractSearchableTagLabels(product);
		const packaging = splitCommaValues(product.imballo);

		return {
			title,
			href: `/prodotti/${slug}`,
			imageSrc: resolveProductThumbnailSrc(product, {
				defaultImage: PRODUCT_CARD_IMAGE,
				brandLogoById,
				width: 760,
				quality: 72,
				format: 'webp',
			}),
			packaging,
			searchText: [title, ...searchableTags, ...packaging].join(' ').toLowerCase(),
		};
	})
	.filter((entry): entry is { title: string; href: string; imageSrc: string; packaging: string[]; searchText: string } => Boolean(entry));
---

<section class="products_overview" data-aos="fade-up" data-aos-duration="1500">
	<div class="products_overview_inner">
		<form class="products_search" data-products-overview-search-form role="search" method="get">
			<input
				type="search"
				name="q"
				class="products_search_input"
				data-products-overview-search
				value={initialSearchQuery}
				placeholder="Cerca per prodotto, tag o imballo"
				aria-label="Cerca prodotti"
			/>
			<button class="products_search_button" type="submit">Cerca</button>
			<button class="products_quote_button" type="button" data-open-quote-popup>Richiedi preventivo</button>
		</form>

		<div class="products_overview_results" data-products-overview-results hidden>
			<div class="products_results_head">
				<p class="products_results_count" data-products-overview-count>{productsData.length} prodotti</p>
				<button class="products_clear_filters" type="button" data-products-overview-clear>Reset ricerca</button>
			</div>

			<div class="products_result_section" data-products-overview-categories-results>
				<h3 class="products_result_section_title">Categorie</h3>
				<div class="categorie_prodotti_grid" data-products-overview-category-grid>
					{categoryCardsSearch.map((entry) => (
						<a class="categorie_prodotti_card" href={entry.href} data-search={entry.searchText}>
							{entry.imageSrc && (
								<div class="categorie_prodotti_media">
									<img src={entry.imageSrc} alt={entry.title} loading="lazy" />
								</div>
							)}
							<h2 class="categorie_prodotti_card_title">{entry.title}</h2>
							{entry.description && <p class="categorie_prodotti_card_subtitle">{entry.description}</p>}
						</a>
					))}
				</div>
			</div>

			<div class="products_result_section" data-products-overview-products-results>
				<h3 class="products_result_section_title">Prodotti</h3>
				<div class="products_grid" data-products-overview-grid>
					{productsData.map((entry) => (
						<a class="products_card" href={entry.href} data-search={entry.searchText} data-packaging={entry.packaging.join('||').toLowerCase()}>
							{entry.imageSrc && (
								<div class="products_card_media">
									<img src={entry.imageSrc} alt={entry.title} loading="lazy" />
								</div>
							)}
							<h3 class="products_card_title">{entry.title}</h3>
						</a>
					))}
				</div>
			</div>

			<p class="products_empty" data-products-overview-empty>Nessun risultato trovato.</p>
		</div>

		{categoryCardsTopLevel.length > 0 && (
			<div class="categorie_prodotti_wrap" data-products-overview-categories>
				<div class="categorie_prodotti_grid">
					{categoryCardsTopLevel.map((single) => (
						<a class="categorie_prodotti_card" href={single.href}>
							{single.imageSrc && (
								<div class="categorie_prodotti_media">
									<img src={single.imageSrc} alt={single.title} loading="lazy" />
								</div>
							)}
							<h2 class="categorie_prodotti_card_title">{single.title}</h2>
							{single.description && <p class="categorie_prodotti_card_subtitle">{single.description}</p>}
						</a>
					))}
				</div>
			</div>
		)}
	</div>
</section>

<script is:inline>
	(() => {
		const searchForm = document.querySelector('[data-products-overview-search-form]');
		const searchInput = document.querySelector('[data-products-overview-search]');
		const resultsWrap = document.querySelector('[data-products-overview-results]');
		const categoriesWrap = document.querySelector('[data-products-overview-categories]');
		const clearButton = document.querySelector('[data-products-overview-clear]');
		const countElement = document.querySelector('[data-products-overview-count]');
		const emptyElement = document.querySelector('[data-products-overview-empty]');
		const productSection = document.querySelector('[data-products-overview-products-results]');
		const categorySection = document.querySelector('[data-products-overview-categories-results]');
		const productCards = Array.from(document.querySelectorAll('[data-products-overview-grid] .products_card'));
		const categoryCards = Array.from(document.querySelectorAll('[data-products-overview-category-grid] .categorie_prodotti_card'));
		const querySearchTermRaw = new URLSearchParams(window.location.search).get('q') || '';
		const querySearchTerm = querySearchTermRaw.trim().toLowerCase();
		let searchTerm = querySearchTerm;
		let activeSearchTerm = querySearchTerm;

		const normalizeText = (value) =>
			String(value || '')
				.toLowerCase()
				.normalize('NFD')
				.replace(/[\u0300-\u036f]/g, ' ')
				.replace(/[^a-z0-9\s-]/g, ' ')
				.replace(/\s+/g, ' ')
				.trim();

		const matchesSearch = (searchable, query) => {
			const normalizedQuery = normalizeText(query);
			if (!normalizedQuery) return true;
			const normalizedSearchable = normalizeText(searchable);
			const queryTokens = normalizedQuery.split(' ').filter(Boolean);
			return queryTokens.every((token) => normalizedSearchable.includes(token));
		};

		const packagingTypes = new Set(['tanica', 'fusto', 'secchio', 'barile', 'cisterna', 'flacone', 'bottiglia', 'lattina', 'sacco', 'cartuccia', 'latta']);

		const parsePackagingQuery = (query) => {
			const normalized = normalizeText(query);
			if (!normalized) return null;
			const tokens = normalized.split(' ').filter(Boolean);
			if (tokens.length < 2) return null;
			const type = tokens[0];
			if (!packagingTypes.has(type)) return null;
			const sizeToken = tokens.find((token) => /^\d+(?:[.,]\d+)?$/.test(token));
			if (!sizeToken) return null;
			return { type, size: sizeToken.replace(',', '.') };
		};

		const matchesPackagingQuery = (packagingRaw, query) => {
			const parsed = parsePackagingQuery(query);
			if (!parsed) return null;
			const entries = String(packagingRaw || '')
				.split('||')
				.map((entry) => normalizeText(entry))
				.filter(Boolean);
			if (entries.length === 0) return false;
			return entries.some((entry) => {
				const tokens = entry.split(' ').filter(Boolean);
				const hasType = tokens.includes(parsed.type);
				const hasSize = tokens.some((token) => token.replace(',', '.') === parsed.size);
				return hasType && hasSize;
			});
		};

		if (searchInput instanceof HTMLInputElement) {
			searchInput.value = querySearchTermRaw.trim();
		}

		const applySearch = () => {
			let visibleProductCount = 0;
			let visibleCategoryCount = 0;

			productCards.forEach((card) => {
				const searchable = (card.getAttribute('data-search') || '').toLowerCase();
				const packagingRaw = card.getAttribute('data-packaging') || '';
				const packagingMatch = matchesPackagingQuery(packagingRaw, activeSearchTerm);
				const match = packagingMatch === null ? matchesSearch(searchable, activeSearchTerm) : packagingMatch;
				card.style.display = match ? '' : 'none';
				if (match) visibleProductCount += 1;
			});

			categoryCards.forEach((card) => {
				const searchable = (card.getAttribute('data-search') || '').toLowerCase();
				const match = matchesSearch(searchable, activeSearchTerm);
				card.style.display = match ? '' : 'none';
				if (match) visibleCategoryCount += 1;
			});

			const visibleCount = visibleProductCount + visibleCategoryCount;

			if (resultsWrap instanceof HTMLElement) resultsWrap.hidden = !activeSearchTerm;
			if (categoriesWrap instanceof HTMLElement) categoriesWrap.hidden = Boolean(activeSearchTerm);
			if (productSection instanceof HTMLElement) productSection.hidden = visibleProductCount === 0;
			if (categorySection instanceof HTMLElement) categorySection.hidden = visibleCategoryCount === 0;
			if (emptyElement instanceof HTMLElement) emptyElement.style.display = visibleCount > 0 ? 'none' : 'block';
			if (countElement instanceof HTMLElement) {
				countElement.textContent = `${visibleCount} risultati (${visibleCategoryCount} categorie, ${visibleProductCount} prodotti)`;
			}
			if (clearButton instanceof HTMLElement) clearButton.style.visibility = activeSearchTerm ? 'visible' : 'hidden';
		};

		if (searchInput instanceof HTMLInputElement) {
			searchInput.addEventListener('input', () => {
				searchTerm = searchInput.value.trim().toLowerCase();
			});
		}

		if (searchForm instanceof HTMLFormElement) {
			searchForm.addEventListener('submit', (event) => {
				event.preventDefault();
				const submittedTerm = searchInput instanceof HTMLInputElement
					? searchInput.value.trim().toLowerCase()
					: searchTerm;
				const nextParams = new URLSearchParams(window.location.search);
				if (submittedTerm) {
					nextParams.set('q', submittedTerm);
				} else {
					nextParams.delete('q');
				}
				const query = nextParams.toString();
				const targetUrl = query ? `${window.location.pathname}?${query}` : window.location.pathname;
				window.location.assign(targetUrl);
			});
		}

		if (clearButton instanceof HTMLButtonElement) {
			clearButton.addEventListener('click', () => {
				activeSearchTerm = '';
				searchTerm = '';
				if (searchInput instanceof HTMLInputElement) searchInput.value = '';
				applySearch();
			});
		}

		applySearch();
	})();
</script>

<style>
	.products_overview {
		padding: 0 20px 56px;
	}

	.products_overview_inner {
		max-width: var(--max-width);
		margin: 0 auto;
	}

	.products_search {
		margin-bottom: 28px;
		display: flex;
		gap: 10px;
		align-items: center;
		justify-content: center;
		width: 100%;
	}

	.products_search_input {
		width: min(100%, 520px);
		max-width: 520px;
		height: 52px;
		border: 1px solid rgba(0, 0, 0, 0.18);
		border-radius: 999px;
		padding: 0 20px;
		font: inherit;
		font-size: 16px;
		background: #fff;
		color: var(--nero);
	}

	.products_search_input:focus {
		outline: none;
		border-color: var(--arancione-battistel);
		box-shadow: 0 0 0 3px rgba(255, 64, 0, 0.18);
	}

	.products_search_button {
		appearance: none;
		border: 0;
		border-radius: 999px;
		padding: 0 24px;
		height: 52px;
		font: inherit;
		font-weight: 700;
		background: var(--arancione-battistel);
		color: #fff;
		cursor: pointer;
		transition: transform 180ms ease, filter 180ms ease;
	}

	.products_search_button:hover {
		filter: brightness(1.04);
		transform: translateY(-1px);
	}

	.products_quote_button {
		appearance: none;
		border: 1px solid rgba(0, 0, 0, 0.2);
		border-radius: 999px;
		padding: 0 20px;
		height: 52px;
		font: inherit;
		font-weight: 700;
		background: #fff;
		color: var(--nero);
		cursor: pointer;
		transition: transform 180ms ease, border-color 180ms ease;
	}

	.products_quote_button:hover {
		transform: translateY(-1px);
		border-color: var(--arancione-battistel);
	}

	.products_overview_results {
		margin-bottom: 32px;
	}

	.products_result_section + .products_result_section {
		margin-top: 24px;
	}

	.products_result_section_title {
		margin: 0 0 12px;
		font-size: 18px;
		font-weight: 700;
	}

	.products_results_head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		margin-bottom: 18px;
	}

	.products_results_count {
		margin: 0;
		font-size: 15px;
		font-weight: 600;
		color: rgba(0, 0, 0, 0.78);
	}

	.products_clear_filters {
		visibility: hidden;
		appearance: none;
		border: 0;
		background: transparent;
		color: var(--arancione-battistel);
		font: inherit;
		font-size: 14px;
		font-weight: 600;
		cursor: pointer;
		padding: 0;
	}

	.categorie_prodotti_grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.products_grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.categorie_prodotti_card,
	.products_card {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 24px;
		background: var(--bianco);
		border: 1px solid rgba(0, 0, 0, 0.09);
		border-radius: 14px;
		color: var(--nero);
		text-decoration: none;
		transition: transform 180ms ease, box-shadow 180ms ease;
		width: 100%;
		box-sizing: border-box;
	}

	.categorie_prodotti_card:hover,
	.a.products_card:hover,
	.products_card:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
	}

	.categorie_prodotti_media,
	.products_card_media {
		overflow: hidden;
		border-radius: 10px;
		aspect-ratio: 4 / 3;
		width: 100%;
		background: #f8f8f8;
	}

	.categorie_prodotti_media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.products_card_media img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.categorie_prodotti_card_title,
