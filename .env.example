PUBLIC_DIRECTUS_URL=https://admin.battistel.com
# Flow usato dai form per inviare richieste a Directus
PUBLIC_DIRECTUS_FLOW_TRIGGER_ID=dc9878bd-9ee6-468f-aa2d-852910c6af41
# In alternativa puoi impostare direttamente il webhook completo
# PUBLIC_DIRECTUS_WEBHOOK_RICHIESTE=https://admin.battistel.com/flows/trigger/dc9878bd-9ee6-468f-aa2d-852910c6af41
# Imposta a true quando il certificato del Directus e' valido e verificabile.
DIRECTUS_TLS_REJECT_UNAUTHORIZED=false
# Mostra la pagina "sito in aggiornamento" solo su www.battistel.com.
PUBLIC_MAINTENANCE_WWW=false
PUBLIC_SITE_URL=https://www.battistel.com
# Abilita le trasformazioni immagini Directus nelle URL asset.
PUBLIC_DIRECTUS_ASSET_TRANSFORMS=true
